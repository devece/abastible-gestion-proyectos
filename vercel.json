{
  "headers": [
    {
      "source": "/Abastible_Gestion_v8.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/Abastible_Gestion_v8.html" }
  ]
}
